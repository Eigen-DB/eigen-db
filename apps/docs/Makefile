# Makefile for docs
# Official EigenDB documentation
# Owner: @ryan-awad
# Maintainers: @ryan-awad

.PHONY: all run help

# Default target
all: run

# Run the docs dev server
run:
	npx mint dev

# Help target
help:
	@echo "Available targets:"
	@echo "  run  : Run the docs dev server"
	@echo "  all  : Default target (run)"
